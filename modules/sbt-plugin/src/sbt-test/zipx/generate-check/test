# Verify zipx generates a correct workflow and the generate/check round-trip is idempotent.
> zipxGraph
> zipxWorkflowGenerate
$ exists .github/workflows/ci.yml
$ exists .github/workflows/zipx-version-updates.yml
$ exists project/zipx-ci.env
$ exists .github/actions/zipx-sbt-setup/action.yml
$ absent .github/actions/zipx-aws-login/action.yml
> assertGraph
# Freshly generated file must pass the check (determinism / idempotence).
> zipxWorkflowCheck
# Affected handoff for CI: task writes JSON to a file (never rely on capturing sbt stdout).
> zipxAffectedModules HEAD
$ exists target/zipx-affected.json
# Fail open: this dir is not a git repo, so the diff cannot run, and an empty list would skip all verification.
> assertAffectedFailsOpen
# A bogus base ref is the same class of failure: bad ref, missing object, or force-pushed base.
> zipxAffectedModules deadbeefdeadbeefdeadbeefdeadbeefdeadbeef
> assertAffectedFailsOpen
# In a real repo the diff succeeds and finds nothing, which must stay empty: fail-open keys off diff failure.
$ exec git init -q .
$ exec git config user.email scripted@example.com
$ exec git config user.name scripted
$ exec git config commit.gpgsign false
$ exec git add .
$ exec git commit -q -m fixture
> zipxAffectedModules HEAD
> assertAffectedEmptyStaysEmpty

# Snapshots publish Ship rows; a catalog without any is refused.
$ copy-file changes/snapshots.sbt snapshots.sbt
> reload
-> zipxWorkflowGenerate
$ delete snapshots.sbt
> reload
