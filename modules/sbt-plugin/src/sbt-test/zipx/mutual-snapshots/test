# Two repos that depend on each other, the way ascent and heddle do. Each phase swaps build.sbt and the catalog,
# commits, and publishes to one file: registry. Commit ids are real shas, recorded by name.
$ copy-file changes/gitignore .gitignore
$ exec git init -q .
$ exec git config user.email scripted@example.com
$ exec git config user.name scripted
$ exec git config commit.gpgsign false
$ exec git add -A
$ exec git commit -q -m ascent

# 1. Ascent releases dom 0.10.0, opens 0.11.0, and publishes commit a1.
> zipxRelease refs/tags/dom/v0.10.0
> zipxSession development
> zipxModverBump minor
> reload
$ exec git add -A
$ exec git commit -q -m a1
> recordSha a1
> zipxSnapshotPublish
> assertInRegistry ascent-dom-facade_sjs1_3 release 0.10.0
> assertInRegistry ascent-dom-facade_sjs1_3 commit 0.11.0 a1

# 2. Heddle h0 is built against the released facade 0.10.0.
$ copy-file build.sbt saved/ascent.sbt
$ copy-file project/ZipxVersions.scala saved/AscentVersions.scala
$ copy-file changes/heddle.sbt build.sbt
$ copy-file changes/HeddleVersions.scala project/ZipxVersions.scala
> reload
$ exec git add -A
$ exec git commit -q -m h0
> recordSha h0
> zipxSnapshotPublish
> assertHeddleNamesFacade h0 release 0.10.0

# 3. Heddle h1 pins ascent's commit a1.
> pinCommit ascent-dom-facade 0.11.0 a1
> reload
$ exec git add -A
$ exec git commit -q -m h1
> recordSha h1
> zipxSnapshotPublish
> assertHeddleNamesFacade h1 commit 0.11.0 a1

# 4. Ascent moves on (a2, same 0.11.0 line) and pins heddle h0, built against facade 0.10.0.
$ copy-file saved/ascent.sbt build.sbt
$ copy-file saved/AscentVersions.scala project/ZipxVersions.scala
$ copy-file changes/Facade.v2.scala dom-facade/src/main/scala/Facade.scala
$ copy-file changes/McpAppWithHeddle.scala mcp-app/src/main/scala/McpApp.scala
$ touch use-heddle
> reload
> pinCommit heddle 0.9.0 h0
> reload
$ exec git add -A
$ exec git commit -q -m a2
-> mcpAppJS/update
-> docsJS/update

# 5. Ascent pins heddle h1, built against facade a1: an older commit of the line this build compiles.
> pinCommit heddle 0.9.0 h1
> reload
-> mcpAppJS/update
-> docsJS/update
