# Two repos that depend on each other, the way ascent and heddle do. Each phase swaps build.sbt and the catalog,
# commits, and publishes to one file: registry. Commit ids are real shas, recorded by name.
$ copy-file changes/gitignore .gitignore
$ exec git init -q .
$ exec git config user.email scripted@example.com
$ exec git config user.name scripted
$ exec git config commit.gpgsign false
$ exec git add -A
$ exec git commit -q -m ascent

# 1. Ascent releases dom 0.10.0, opens 0.11.0, and publishes commit a1.
> zipxRelease refs/tags/dom/v0.10.0
> zipxSession development
> zipxModverBump minor
> reload
$ exec git add -A
$ exec git commit -q -m a1
> recordSha a1
> zipxSnapshotPublish
> assertInRegistry ascent-dom-facade_sjs1_3 release 0.10.0
> assertInRegistry ascent-dom-facade_sjs1_3 commit 0.11.0 a1

# 2. Heddle h0 is built against the released facade 0.10.0.
$ copy-file build.sbt saved/ascent.sbt
$ copy-file project/ZipxVersions.scala saved/AscentVersions.scala
$ copy-file changes/heddle.sbt build.sbt
$ copy-file changes/HeddleVersions.scala project/ZipxVersions.scala
> reload
$ exec git add -A
$ exec git commit -q -m h0
> recordSha h0
> zipxSnapshotPublish
> assertHeddleNamesFacade h0 release 0.10.0

# 3. Heddle h1 pins ascent's commit a1.
> pinCommit ascent-dom-facade 0.11.0 a1
> reload
$ exec git add -A
$ exec git commit -q -m h1
> recordSha h1
> zipxSnapshotPublish
> assertHeddleNamesFacade h1 commit 0.11.0 a1

# 4. Ascent moves on (a2, same 0.11.0 line) and pins heddle h0, built against facade 0.10.0. The app and the docs
# site compile the in-repo facade. What heddle asked for never enters the graph: the app keeps heddle from bringing it.
$ copy-file project/ZipxVersions.scala saved/HeddleVersions.scala
$ copy-file saved/ascent.sbt build.sbt
$ copy-file saved/AscentVersions.scala project/ZipxVersions.scala
$ copy-file changes/Facade.v2.scala dom-facade/src/main/scala/Facade.scala
$ copy-file changes/McpAppWithHeddle.scala mcp-app/src/main/scala/McpApp.scala
$ touch use-heddle
> reload
> pinCommit heddle 0.9.0 h0
> reload
$ exec git add -A
$ exec git commit -q -m a2
> mcpAppJS/update
> docsJS/update
> assertFacadeInRepo release 0.10.0
> assertDocsFacadeInRepo release 0.10.0

# 5. The #204 case: ascent pins heddle h1, built against facade a1, an older commit of the line this build compiles.
> pinCommit heddle 0.9.0 h1
> reload
> mcpAppJS/update
> docsJS/update
> assertFacadeInRepo commit 0.11.0 a1
> assertDocsFacadeInRepo commit 0.11.0 a1
> mcpAppJS/compile
> assertZipxResolver
$ exec git add -A
$ exec git commit -q -m a2-pins-h1

# 6. Heddle h2 moves heddle's pointer.
$ copy-file project/ZipxVersions.scala saved/AscentVersions.scala
$ copy-file changes/heddle.sbt build.sbt
$ copy-file saved/HeddleVersions.scala project/ZipxVersions.scala
$ copy-file changes/Heddle.v2.scala heddle/src/main/scala/Heddle.scala
> reload
$ exec git add -A
$ exec git commit -q -m h2
> recordSha h2
> zipxSnapshotPublish
> assertPointerNames heddle-mcp-apps_sjs1_3 0.9.0 h2

# 7. Ascent takes heddle's newest commit the way the weekly job does: no arguments, one rewrite for the heddle family,
# in the stored form. A bare pin fails update before anything resolves, and advance repairs it.
$ copy-file project/ZipxVersions.scala saved/HeddleVersions.scala
$ copy-file saved/ascent.sbt build.sbt
$ copy-file saved/AscentVersions.scala project/ZipxVersions.scala
> reload
> zipxSnapshotStatus
> zipxSnapshotAdvance
> reload
> assertPin heddle 0.9.0 h2
> mcpAppJS/update
> assertFacadeInRepo commit 0.11.0 a1
> pinBare heddle 0.9.0 h2
> reload
-> mcpAppJS/update
> zipxSnapshotAdvance heddle-mcp-apps
> reload
> assertPin heddle 0.9.0 h2
> mcpAppJS/compile

# 8. The docs site takes a docs framework built against heddle h0, an older commit of the line ascent pins, the way
# ascent's docs take specular. The catalog's h2 is what the site resolves, with no override in build.sbt.
> writeDocsFramework 1.0.0 commit 0.9.0 h0
$ touch use-docs-framework
> reload
> docsJS/update
> assertDocsSelects heddle-mcp-apps_sjs1_3 commit 0.9.0 h2
$ exec git add -A
$ exec git commit -q -m a3-docs

# 9. Heddle opens 0.10.0 and publishes h3, and the docs framework's next release is built against it. That is newer than
# ascent's pin: resolution still forces the pin, update refuses it, and advancing the row to that line clears it.
$ copy-file project/ZipxVersions.scala saved/AscentVersions.scala
$ copy-file changes/heddle.sbt build.sbt
$ copy-file saved/HeddleVersions.scala project/ZipxVersions.scala
> reload
> zipxModverBump heddle minor
> reload
$ exec git add -A
$ exec git commit -q -m h3
> recordSha h3
> zipxSnapshotPublish
> assertPointerNames heddle-mcp-apps_sjs1_3 0.10.0 h3
> assertNextHeddleNamesFacade h3 commit 0.11.0 a1
$ copy-file saved/ascent.sbt build.sbt
$ copy-file saved/AscentVersions.scala project/ZipxVersions.scala
> reload
> writeDocsFramework 1.1.0 commit 0.10.0 h3
> pinVersion docs-framework 1.1.0
> reload
> docsJS/updateFull
> assertDocsSelects heddle-mcp-apps_sjs1_3 commit 0.9.0 h2
-> docsJS/update
> zipxSnapshotAdvance heddle-mcp-apps 0.10.0
> reload
> assertPin heddle 0.10.0 h3
> docsJS/update
> assertDocsSelects heddle-mcp-apps_sjs1_3 commit 0.10.0 h3
> mcpAppJS/compile

# 10. Ascent publishes a3. The app's POM keeps heddle-mcp-apps, built against facade a1, from bringing the facade or js:
# the app states both itself.
$ exec git add -A
$ exec git commit -q -m a3
> recordSha a3
> zipxSnapshotPublish
> assertAppExcludes a3 ascent-dom-facade_sjs1_3 ascent-js_sjs1_3

# 11. A third repo depends only on the app at a3. It meets heddle's POM and the app's at once, and resolves one facade:
# a3, the one the app was built with. Nothing orders a1 and a3, so without the app's exclusions update would refuse.
$ copy-file changes/demo.sbt build.sbt
$ copy-file changes/DemoVersions.scala project/ZipxVersions.scala
> reload
> pinCommit ascent-mcp-app 0.10.0 a3
> reload
> demoJS/update
> assertDemoSelects ascent-dom-facade_sjs1_3 commit 0.11.0 a3
